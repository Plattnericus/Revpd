[Unit]
Description=Revpd — MFA gateway for RDP with Wake-on-LAN
Documentation=https://github.com/plattnericus/revpd
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/revpd serve -c /etc/revpd/revpd.yaml
EnvironmentFile=/etc/revpd/.env
Restart=on-failure
RestartSec=5s

User=revpd
Group=revpd

# Binding 3389 is the only privilege needed. Everything else stays dropped.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Filesystem: read-only everywhere except the database directory.
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/revpd
PrivateTmp=yes
PrivateDevices=yes

# Kernel and process isolation.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

# Only the address families actually used: TCP/UDP over IPv4 and IPv6.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete

UMask=0077

# The database is small; this is plenty and caps the damage of a leak.
LimitNOFILE=8192
MemoryMax=512M

[Install]
WantedBy=multi-user.target
