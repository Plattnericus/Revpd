# Revpd — environment file
#
# Copy to .env and fill in. Nothing in here belongs in version control.
#   cp .env.example .env && chmod 600 .env
#
# On a systemd host this is loaded with EnvironmentFile=/etc/revpd/.env


# ---------------------------------------------------------------- required --

# Encrypts TOTP seeds and Duo keys at rest. 32 bytes, hex encoded.
# Generate one with:   revpd genkey
#
# Losing this means every enrolled second factor has to be set up again.
# Changing it has the same effect. Back it up somewhere safe.
REVPD_MASTER_KEY=

# The name users type into their browser and RDP client.
# Also the WebAuthn relying-party ID — changing it invalidates all passkeys.
REVPD_WEB_HOSTNAME=gw.example.com


# ---------------------------------------------------------------- optional --

# Path to the config file. Defaults to /etc/revpd/revpd.yaml
#REVPD_CONFIG=/etc/revpd/revpd.yaml

# Where the database lives. Defaults to /var/lib/revpd
#REVPD_DATA_DIR=/var/lib/revpd

# Listen addresses. Override only if the defaults clash with something.
#REVPD_WEB_LISTEN=:8443
#REVPD_RELAY_LISTEN=:3389

# TLS. Either let Let's Encrypt handle it (needs port 80 reachable)
# or point at your own certificate.
#REVPD_ACME=true
#REVPD_TLS_CERT=/etc/revpd/tls/fullchain.pem
#REVPD_TLS_KEY=/etc/revpd/tls/privkey.pem


# ------------------------------------------------------------------- duo ----
# Only needed for push approvals. Leave empty to use TOTP codes alone.
# Get these from the Duo admin panel: Applications -> Auth API.

#REVPD_DUO_API_HOST=api-xxxxxxxx.duosecurity.com
#REVPD_DUO_IKEY=
#REVPD_DUO_SKEY=


# ----------------------------------------------------------------- tuning ---

# How long a passed MFA stays good for starting a connection.
#REVPD_GRANT_TTL=2m

# Reconnect window after a dropped link, before MFA is asked for again.
#REVPD_GRANT_REUSE_WINDOW=10m

# Set when something like nginx sits in front. Comma separated CIDRs.
# Leave empty otherwise: trusting these blindly lets anyone spoof their
# source address and walk into somebody else's session.
#REVPD_TRUSTED_PROXIES=127.0.0.1/32,10.0.0.0/8
